/*
 * Copyright 2026 Turing Software LLC
 * SPDX-License-Identifier: MIT
 *
 * Version resource for the Triton UMD DLLs.  The version is passed by the
 * resource compiler command line (VER=a.b.c.d, VER_COMMA=a,b,c,d) so the
 * meson build and the ARM64X forwarder link share this one file; the package
 * builder passes the INF DriverVer, which Windows requires the UMD's file
 * version to match.
 */

#include <windows.h>

#define NPT_RC_STR2(x) #x
#define NPT_RC_STR(x) NPT_RC_STR2(x)

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VER_COMMA
 PRODUCTVERSION VER_COMMA
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DRV
 FILESUBTYPE VFT2_DRV_DISPLAY
{
    BLOCK "StringFileInfo"
    {
        BLOCK "040904b0"
        {
            VALUE "CompanyName", "Turing Software LLC"
            VALUE "FileDescription", "Neptune Direct3D User Mode Driver"
            VALUE "FileVersion", NPT_RC_STR(VER)
            VALUE "InternalName", "neptune_umd"
            VALUE "OriginalFilename", "neptune_umd.dll"
            VALUE "ProductName", "Neptune"
            VALUE "ProductVersion", NPT_RC_STR(VER)
        }
    }
    BLOCK "VarFileInfo"
    {
        VALUE "Translation", 0x409, 1200
    }
}
